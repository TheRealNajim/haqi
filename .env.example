# haqi .env.example  (owner: infra)
# Names below are FIXED by docs/CONTRACTS.md. Adding/renaming any = a CONTRACTS change
# = PR + both owners + team-channel announcement (AGENTS.md §3).
# Copy this file to `.env`, fill real values, and NEVER commit `.env` (AGENTS.md §6).
# Canonical full list. backend/.env.example is the backend-scoped copy; keep them in
# sync — every name below must exist in the deployed Render env or the slot is an
# honest blind spot (see /sources/status).

# --- Data sources (backend adapters) ---
OPENAQ_API_KEY=
WAQI_TOKEN=
OPENWEATHER_API_KEY=
NASA_FIRMS_MAP_KEY=

# --- govt advisories via Bright Data SERP (zone default: serp_api1) ---
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=serp_api1

# --- platform knibs (safe defaults) ---
HAQI_LOCATION_NAME=Lagos
HAQI_DATA_DIR=data
HAQI_CORS_ORIGINS=

# --- Zetaris platform (local dev; REST never uses 8889) ---
# Deployed backend reaches Zetaris only via a routable URL, never localhost.
ZETARIS_REST_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# --- Nemotron route (ALL THREE must come from ONE route; never mix) ---
# Deployed backend needs a cloud-reachable route (NVIDIA hosted, build.nvidia.com).
# Verified live Oct 26 with our key: this base URL lists the id below in /v1/models
# and answers chat completions in ~1.6 s. Thinking is ON by default (155 tokens for
# the word "OK"); send chat_template_kwargs {"enable_thinking": false} to cut that.
MODEL_BASE_URL=
MODEL_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Meterless Nightshift narration lane (optional; sponsor Build/Power layer) ---
# NOT the parse route. MODEL_* above stays the Nemotron parse lane; this one only writes
# the /why "story" paragraph FROM the logged evidence (agent/llm.py:narrate_why). All three
# or none: miss one and the lane stays off, /why keeps the deterministic graph.
# The URL must be OpenAI-compatible and end in /v1; from Render it must be reachable, so a
# tunnel in front of Nightshift on the infra host (tunnel.ps1 -Port 8088 -StatePrefix meterless).
# Measured 26 Oct: Nightshift answers /healthz on 127.0.0.1:8088 and lists its model ids with
# the proxy token, but every completion returns 503 `local_runtime_not_ready` - no model
# weights are downloaded (models_dir holds only .part stubs). The lane therefore stays off
# until Setup -> Runtime has a model. Do not fake these three to make a badge green.
METERLESS_BASE_URL=
METERLESS_API_KEY=
METERLESS_MODEL=
