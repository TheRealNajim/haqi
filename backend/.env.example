# haqi backend — copy to .env and fill. NEVER commit the real .env.
# Every key is optional for local dev: missing keys = that source reports a
# blind spot honestly, and /today serves labeled fixtures (fallback: true)
# instead of failing. Keys never appear in code or fixtures — see docs/CONTRACTS.md.

# ground stations (primary) — https://openaq.org
OPENAQ_API_KEY=

# ground stations (fallback) — https://waqi.info
WAQI_TOKEN=

# wind/dispersion (3h forecast horizon) — https://openweathermap.org
OPENWEATHER_API_KEY=

# wildfire smoke — https://firms.modaps.eosdis.nasa.gov
NASA_FIRMS_MAP_KEY=

# govt advisories via Google SERP — https://brightdata.com
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=serp_api1

# city name used in advisory searches
HAQI_LOCATION_NAME=Lagos

# trust-ledger directory (gitignored)
HAQI_DATA_DIR=data

# CORS origins the API answers (comma-separated; default = local dev only)
HAQI_CORS_ORIGINS=
