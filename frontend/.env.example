# ---------------------------------------------------------------------------
# frontend/.env.example
#
# IMPORTANT: no secrets belong in this file.
#
# Vite exposes every VITE_* variable by inlining it into the client bundle at
# build time, so anything here is effectively public. Provider credentials
# (OPENAQ_API_KEY, WAQI_TOKEN, OPENWEATHER_API_KEY, NASA_FIRMS_MAP_KEY,
# BRIGHTDATA_API_KEY, ZETARIS_*, MODEL_*) MUST stay in backend/.env only.
#
# Default setup (recommended): the browser calls relative /api/... paths.
# In dev that is handled by a Vite proxy; in prod the UI is served from the
# same origin as FastAPI (or /api is reverse-proxied). With that setup you do
# not need this file at all.
#
# Copy to .env only if you need to override the defaults:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Set to "true" to render from local fixtures with no backend (offline demo).
# Set to "false" or remove to use the live API.
VITE_USE_FIXTURES=true

# Only needed when the API is on a different origin than the UI.
# Leave empty for same-origin / proxy setup.
# Example: VITE_API_BASE_URL=http://localhost:8000
# NOTE: a cross-origin setup also requires CORS middleware on the backend,
# which it does not currently have.
VITE_API_BASE_URL=

# Optional: label shown in the UI for demo/fixture data. Never use this to
# present fixture numbers as live readings.
VITE_DATA_SOURCE_LABEL=Demo fixture · not live data
