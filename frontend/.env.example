# ---------------------------------------------------------------------------
# frontend/.env.example
#
# IMPORTANT: no secrets belong in this file.
#
# Vite exposes every VITE_* variable by inlining it into the client bundle at
# build time, so anything here is effectively public. Provider credentials
# (OPENAQ_API_KEY, WAQI_TOKEN, OPENWEATHER_API_KEY, NASA_FIRMS_MAP_KEY,
# BRIGHTDATA_API_KEY, ZETARIS_*, MODEL_*) MUST stay in backend/.env only.
#
# Copy to .env only if you need to override the defaults:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Offline fixtures vs. live verdicts.
# Empty = live API (the default in dev and production).
# "true"  = force fixtures everywhere (offline demo / fallback renderer).
# "false" = explicit live API (same as empty).
VITE_USE_FIXTURES=

# Public API origin used by the production build.
# Leave empty to use https://haqi-api.onrender.com.
# Ignored during `npm run dev`: the dev server always calls the same-origin
# `/api` proxy below, so a value here cannot trigger cross-origin CORS errors.
VITE_API_BASE_URL=

# Dev-only proxy target (read by vite.config.ts, not shipped to the client).
# Defaults to https://haqi-api.onrender.com.
VITE_API_PROXY_TARGET=

# Optional badge text for fixture/fallback answers. Never use this to present
# fixture numbers as live readings.
VITE_DATA_SOURCE_LABEL=Demo fixture · not live data
