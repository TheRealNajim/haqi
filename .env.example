# haqi .env.example  (owner: infra)
# Names below are FIXED by docs/CONTRACTS.md. Adding/renaming any = a CONTRACTS change
# = PR + both owners + team-channel announcement (AGENTS.md §3).
# Copy this file to `.env`, fill real values, and NEVER commit `.env` (AGENTS.md §6).

# --- Data sources (backend adapters) ---
# Every key here is read by backend/app/adapters/*. A blank value keeps that adapter in
# fallback mode; the app still runs, but live evidence stops there.
OPENAQ_API_KEY=
WAQI_TOKEN=
OPENWEATHER_API_KEY=
NASA_FIRMS_MAP_KEY=
BRIGHTDATA_API_KEY=
# Optional, defaults shown. BRIGHTDATA_SERP_ZONE is asserted by the advisory adapter.
# BRIGHTDATA_SERP_ZONE=serp_api1
# HAQI_LOCATION_NAME=Lagos
# HAQI_DATA_DIR=backend/data

# --- Zetaris platform (local; REST never uses 8889) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# --- Nemotron route (ALL THREE must come from ONE route: Meterless OR NVIDIA) ---
# Meterless:  MODEL_BASE_URL=http://127.0.0.1:8088/v1
#             MODEL_API_KEY=<token from %LOCALAPPDATA%\ai.meterless.runtime\proxy-token>
#             NEMOTRON_MODEL=meterless/auto
# NVIDIA:     MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
#             MODEL_API_KEY=<build.nvidia.com key>
#             NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# Never mix: one route supplies all three values. Leave NEMOTRON_MODEL blank until the
# route is chosen, then use the id that matches MODEL_BASE_URL above.
MODEL_BASE_URL=
MODEL_API_KEY=
NEMOTRON_MODEL=
