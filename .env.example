# haqi .env.example  (owner: infra)
# Names below are FIXED by docs/CONTRACTS.md. Adding/renaming any = a CONTRACTS change
# = PR + both owners + team-channel announcement (AGENTS.md §3).
# Copy this file to `.env`, fill real values, and NEVER commit `.env` (AGENTS.md §6).

# --- Data sources (backend adapters) ---
OPENAQ_API_KEY=
WAQI_TOKEN=

# --- Zetaris platform (local; REST never uses 8889) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# --- Nemotron route (ALL THREE must come from ONE route: Meterless OR NVIDIA) ---
MODEL_BASE_URL=
MODEL_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
