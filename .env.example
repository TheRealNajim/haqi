# haqi .env.example  (owner: infra) — CANONICAL: every env the backend reads
# Names below are FIXED by docs/CONTRACTS.md. Adding/renaming any = a CONTRACTS change
# = PR + both owners + team-channel announcement (AGENTS.md §3).
# Copy this file to `.env`, fill real values, and NEVER commit `.env` (AGENTS.md §6).
# The app parses this file itself — python-dotenv is not a dependency.
#
# Deployed API: paste the same names into Render -> haqi-api -> Environment.
# Render builds with rootDir: backend, so relative paths there resolve inside backend/.

# --- Data sources (backend adapters) ---
# Every key here is read by backend/app/adapters/*. A blank value keeps that adapter in
# fallback mode; the app still runs, but live evidence stops there.
OPENAQ_API_KEY=
WAQI_TOKEN=
OPENWEATHER_API_KEY=
NASA_FIRMS_MAP_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=serp_api1
HAQI_LOCATION_NAME=Lagos
# Trust-ledger directory. Unset = backend/data. On Render use `data` (rootDir is backend/).
# HAQI_DATA_DIR=data

# CORS origins the API answers, comma-separated. Blank = local dev origins only.
# Set this to the deployed frontend origin before the UI calls the API from a browser.
HAQI_CORS_ORIGINS=

# --- Zetaris platform (local; REST never uses 8889) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# UI account; also used for HTTP Basic on the OpenAPI spec (/redoc/docs.yaml).
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# --- Nemotron route (ALL THREE must come from ONE route; never mix) ---
# Decided 25 Oct: NVIDIA hosted (build.nvidia.com). Meterless stays running for eligibility
# only — it has no nvidia/* model and answers 400 no_provider_configured.
# NVIDIA:     MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
#             MODEL_API_KEY=<build.nvidia.com key>
#             NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# Meterless (legacy, local): MODEL_BASE_URL=http://127.0.0.1:8088/v1
#             MODEL_API_KEY=<%LOCALAPPDATA%\ai.meterless.runtime\proxy-token>
#             NEMOTRON_MODEL=meterless/auto
# Leave NEMOTRON_MODEL blank until the route is chosen, then use the id that matches
# MODEL_BASE_URL above.
MODEL_BASE_URL=
MODEL_API_KEY=
NEMOTRON_MODEL=
