# haqi .env.example  (owner: infra)
# Names below are FIXED by docs/CONTRACTS.md. Adding/renaming any = a CONTRACTS change
# = PR + both owners + team-channel announcement (AGENTS.md §3).
# Copy this file to `.env`, fill real values, and NEVER commit `.env` (AGENTS.md §6).
# Canonical full list. backend/.env.example is the backend-scoped copy; keep them in
# sync. An unset name is a disclosed blind — visible as configured:false on
# /sources/status. The two sponsor slots are armed for the judged demo (hybrid
# decision, 26 Oct): values live in Render only.
# A name set to a dead host is not a blind: it errors. (see /sources/status)

# --- Data sources (backend adapters) ---
OPENAQ_API_KEY=
WAQI_TOKEN=
OPENWEATHER_API_KEY=
NASA_FIRMS_MAP_KEY=

# --- govt advisories via Bright Data SERP (zone default: serp_api1) ---
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=serp_api1

# --- platform knibs (safe defaults) ---
HAQI_LOCATION_NAME=Lagos
HAQI_DATA_DIR=data
HAQI_CORS_ORIGINS=

# --- Zetaris platform (runs on the infra PC; REST reaches it via its tunnel) ---
# Deployed backend reaches Zetaris only via a routable URL, never localhost.
# Demo decision (TEAM, 26 Oct night): HYBRID LIVE — the deployed API keeps
# ZETARIS_* armed in Render and reads the tunnel during the judged demo;
# docs/RUNBOOK carry the laptop-independent inspection path. A dead tunnel
# degrades to an honest gap (short REST timeout), never an error page. Values
# live in Render (and local .env for the local runner) — never in this file.
ZETARIS_REST_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# --- Nemotron route (ALL THREE must come from ONE route; never mix) ---
# Deployed backend needs a cloud-reachable route (NVIDIA hosted, build.nvidia.com).
# Verified live Oct 26 with our key: base URL lists the id below in /v1/models and
# answers chat completions in ~1.6 s. NOTE: lightning-30b keeps its reasoning
# channel on and burns tokens per reply; bolt-e4b answers clean — use it.
MODEL_BASE_URL=
MODEL_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-bolt-e4b

# --- Meterless Nightshift narration lane (optional; sponsor Build/Power layer) ---
# NOT the parse route. MODEL_* above stays the Nemotron parse lane; this one only writes
# the /why "story" paragraph FROM the logged evidence (agent/llm.py:narrate_why). All three
# or none: miss one and the lane stays off, /why keeps the deterministic graph.
# The URL must be OpenAI-compatible and end in /v1; from Render it must be reachable, so a
# tunnel in front of Nightshift on the infra host (tunnel.ps1 -Port 8088 -StatePrefix meterless).
# Demo decision (TEAM, 26 Oct night): HYBRID LIVE — Meterless stays armed for the judged
# demo once the narration weights finish downloading; until URL+key+model exist in Render
# the lane reads configured:false (an honest blind, not a bug). Backend lane is already
# built and tested (agent/llm.py:narrate_why) and writes only the /why story field.
METERLESS_BASE_URL=
METERLESS_API_KEY=
METERLESS_MODEL=
